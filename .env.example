# --- Postgres ---
POSTGRES_USER=ghc
POSTGRES_PASSWORD=ghc
POSTGRES_DB=ghc

# --- Encryption for GitHub org PATs (min 16 tegn) ---
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# --- Mercantec Auth ---
MERCANTEC_CLIENT_ID=ghc
MERCANTEC_ISSUER=https://auth.mercantec.tech
MERCANTEC_AUDIENCE=mercantec-apps
MERCANTEC_JWKS_URL=https://auth.mercantec.tech/.well-known/jwks.json
MERCANTEC_AUTHORIZE_URL=https://auth.mercantec.tech/oauth/authorize
MERCANTEC_TOKEN_URL=https://auth.mercantec.tech/oauth/token
MERCANTEC_SIGNOUT_URL=https://auth.mercantec.tech/signout
TEACHER_ROLES=teacher,admin

# --- Lokal (docker-compose.local.yml) ---
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080
REDIRECT_URI=http://localhost:8080/auth/callback
VITE_API_URL=/api

# --- Dokploy / prod (docker-compose.yml alene) ---
