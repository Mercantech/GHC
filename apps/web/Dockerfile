FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ARG VITE_API_URL
ARG VITE_MERCANTEC_CLIENT_ID
ARG VITE_MERCANTEC_AUTHORIZE_URL
ARG VITE_MERCANTEC_TOKEN_URL
ARG VITE_MERCANTEC_SIGNOUT_URL
ARG VITE_REDIRECT_URI
ARG VITE_WEB_ORIGIN
ENV VITE_API_URL=$VITE_API_URL \
    VITE_MERCANTEC_CLIENT_ID=$VITE_MERCANTEC_CLIENT_ID \
    VITE_MERCANTEC_AUTHORIZE_URL=$VITE_MERCANTEC_AUTHORIZE_URL \
    VITE_MERCANTEC_TOKEN_URL=$VITE_MERCANTEC_TOKEN_URL \
    VITE_MERCANTEC_SIGNOUT_URL=$VITE_MERCANTEC_SIGNOUT_URL \
    VITE_REDIRECT_URI=$VITE_REDIRECT_URI \
    VITE_WEB_ORIGIN=$VITE_WEB_ORIGIN
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
